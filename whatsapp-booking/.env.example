# ── WhatsApp (Meta Cloud API) ──────────────────────────────────────────────────
WHATSAPP_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WEBHOOK_VERIFY_TOKEN=choose_any_secret_string_here

# ── Anthropic (Claude AI) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Sheets ──────────────────────────────────────────────────────────────
GOOGLE_SHEETS_ID=your_google_sheet_id_from_url
# Either a file path OR the full JSON content of your service account key:
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# ── Business Settings ──────────────────────────────────────────────────────────
BUSINESS_NAME=My Appointment Business
BUSINESS_SERVICES=Haircut, Colour Treatment, Manicure, Pedicure
BUSINESS_HOURS=Mon-Fri 9am-6pm, Sat 9am-2pm
SLOT_DURATION_MINUTES=60
